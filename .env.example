# Optional. Without it the app runs entirely on the local deterministic engine.
# Server-only: never sent to the browser.
OPENAI_API_KEY=

# Model used for adaptive text turns and for pulling a role out of a pasted
# job posting link (Responses API). Without a key, an imported link still
# returns the extracted page text — it is just not distilled first.
OPENAI_MODEL=gpt-5.6-terra

# Realtime voice interview.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Provider request timeout in milliseconds.
OPENAI_REQUEST_TIMEOUT_MS=15000

# Optional Supabase auth + saved reports. Both are inlined into the client
# bundle at build time, which is fine: the anon/publishable key is designed to
# be public and Row Level Security is the actual security boundary.
# Leave unset to keep the app anonymous and local-only.
# Never put the service_role key or the database password in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Supabase Edge Function that mints Realtime client secrets, which is
# how voice mode works on the static export. This is a public function URL, not
# a key. Leave unset locally: a local server build uses its own route handler.
# e.g. https://<project-ref>.supabase.co/functions/v1/realtime-token
NEXT_PUBLIC_REALTIME_TOKEN_URL=

# Optional. Supabase Edge Function that turns a link to a job posting into job
# description text, which is how link import works on the static export. Also a
# public function URL, not a key. Leave unset locally: a local server build uses
# its own route handler. Unset in a static build hides the import field.
# e.g. https://<project-ref>.supabase.co/functions/v1/job-link
NEXT_PUBLIC_JOB_LINK_URL=
