# Optional. Without it the app runs entirely on the local deterministic engine.
# Server-only: never sent to the browser.
OPENAI_API_KEY=

# Model used for adaptive text turns (Responses API).
OPENAI_MODEL=gpt-5.6-terra

# Realtime voice interview.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Provider request timeout in milliseconds.
OPENAI_REQUEST_TIMEOUT_MS=15000

# Optional Supabase auth + saved reports. Both are inlined into the client
# bundle at build time, which is fine: the anon/publishable key is designed to
# be public and Row Level Security is the actual security boundary.
# Leave unset to keep the app anonymous and local-only.
# Never put the service_role key or the database password in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
